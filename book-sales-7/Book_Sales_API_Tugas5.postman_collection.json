          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/genres",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "genres"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Misteri\",\n  \"description\": \"Genre yang berisi teka-teki dan penyelidikan.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"genre_id\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
